<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>

 <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f2f2f2;
    }

    .app {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .header {
      height: 70px;
      background: white;
      border-bottom: 1px solid #ddd;
      display: flex;
      align-items: center;
      padding: 0 20px;
      gap: 16px;
    }

    .logo img{
      height: 60px;     
    }
    

    .title {
      flex: 1;
      text-align: center;
      font-size: 22px;
    }

    .menu button {
      margin-left: 10px;
      padding: 8px 14px;
      border: 1px solid #ccc;
      background: #fff;
      cursor: pointer;
      border-radius: 8px;
    }

    

    .content {
      flex: 1;
      display: flex;
    }

    .sidebar {
      width: 220px;
      background: white;
      border-right: 1px solid #ddd;
      padding: 20px;
    }

    .sidebar h3 {
      margin-bottom: 15px;
    }

    .sidebar ul {
      list-style: none;
    }

    .sidebar li {
      padding: 10px;
      border: 1px solid #ddd;
      margin-bottom: 10px;
      border-radius: 8px;
      cursor: pointer;
    }

   

    .main {
      flex: 1;
      padding: 20px;
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      align-content: flex-start;
    }

    .card {
      width: 220px;
      background: white;
      border-radius: 12px;
      padding: 12px;
      border: 1px solid #ddd;
    }

    .card h4 {
      margin-bottom: 10px;
    }

    .img-wrap {
      width: 100%;
      height: 180px;
      border: 2px dashed #aaa;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
      background: #fafafa;
      overflow: hidden;
    }

    .img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .img-placeholder {
      color: #777;
      font-size: 14px;
      text-align: center;
      padding: 10px;
    }

    .card p {
      font-size: 14px;
      color: #333;
    }
  </style>
</head>

<body>
  <div id="root"></div>

  <script type="text/babel">
    function Header() {
      return (
        <div className="header">
          <div className="logo"><img src="./images.png" /></div>
          <div className="title"><b>ROZETKA</b></div>
          <div className="menu">
            <button>Press me!</button>
            <button>Press me!</button>
            <button>Press me!</button>
          </div>
        </div>
      );
    }

    function Sidebar() {
      return (
        <div className="sidebar">
          <h3>Категории</h3>
          <ul>
            <li>Список</li>
            <li>Категория 1</li>
            <li>Категория 2</li>
            <li>Категория 3</li>
          </ul>
        </div>
      );
    }

    function Card({ title, text, imgSrc }) {
      return (
        <div className="card">
          <h4>{title}</h4>

          <div className="img-wrap">
            {imgSrc ? (
              <img src={imgSrc} alt={title} />
            ) : (
              <div className="img-placeholder">
                (<img src="./shopping.webp" />)
              </div>
            )}
          </div>

          <p>{text}</p>
        </div>
      );
    }

    function Main() {
      const items = [
        { id: 1, title: "Card1", text: "Awesome computer!", imgSrc: "" },
        { id: 2, title: "Card2", text: "Awesome computer!", imgSrc: "" }
      ];

      return (
        <div className="main">
          {items.map(it => (
            <Card key={it.id} title={it.title} text={it.text} imgSrc={it.imgSrc} />
          ))}
        </div>
      );
    }

    function App() {
      return (
        <div className="app">
          <Header />
          <div className="content">
            <Sidebar />
            <Main />
          </div>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>


</body>

</html>
